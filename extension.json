{
	"name": "SimpleMathJax",
	"version": "0.8.11.ve",
	"author": "jmnote",
	"url": "https://www.mediawiki.org/wiki/Extension:SimpleMathJax",
	"description": "render TeX between <code><nowiki><math></nowiki></code> and <code><nowiki></math></nowiki></code>",
	"license-name": "GPL-2.0+",
	"type": "parserhook",
	"AutoloadClasses": {
		"SimpleMathJaxHooks": "SimpleMathJaxHooks.php"
	},
	"config": {
		"SmjUseCdn": {"value":true, "description":"true to load mathjax from CDN"},
		"SmjUseChem": {"value":true, "description":"true to enabled chem tag"},
		"SmjDirectMathJax": {"value":"full", "description":"env to disable escapes, none to only math and chem tags"},
		"SmjDisplayMath": {"value":[], "description":"MathJax.tex.displayMath"},
		"SmjExtraInlineMath": {"value":[], "description":"MathJax.tex.inlineMath"},
		"SmjIgnoreHtmlClass": {"value":"mathjax_ignore|comment|diff-(context|addedline|deletedline)", "description":"MathJax.options.ignoreHtmlClass"},
		"SmjScale": {"value":1, "description":"MathJax.chtml.scale"},
		"SmjEnableMenu": {"value":true, "description":"MathJax.options.enableMenu"},
		"SmjDisplayAlign": {"value":"left", "description":"MathJax.chtml.displayAlign"},
		"SmjWrapDisplaystyle": {"value":true, "description":"true to wrap with displaystyle"},
		"SmjEnableHtmlAttributes": {"value":false, "description":"true to process attributes of math tag"},
		"SmjConfigByRevision": {"value":[], "description":"switch the configuration"}
	},
	"Hooks": {
		"ParserFirstCallInit": "SimpleMathJaxHooks::onParserFirstCallInit"
	},
	"attributes": {
		"VisualEditor": {
			"PluginModules": [
				"ext.SimpleMathJax.visualEditor",
				"ext.SimpleMathJax.visualEditorRaw"
			]
		}
	},
	"ResourceModules": {
		"ext.SimpleMathJax": {
			"scripts": ["resources/ext.SimpleMathJax.js"],
			"targets": ["desktop", "mobile"]
		},
		"ext.SimpleMathJax.visualEditor": {
			"scripts": [
				"resources/ve-smj/ve.dm.SMJMathNode.js",
				"resources/ve-smj/ve.ce.SMJMathNode.js",
				"resources/ve-smj/ve.ui.SMJMathInspector.js",
				"resources/ve-smj/ve.ui.SMJMathTools.js"
			],
			"dependencies": [
				"ext.visualEditor.mwcore",
				"ext.visualEditor.mwextensions"
			],
			"messages": [
				"simplemathJax-visualeditor-inspector-title",
				"simplemathJax-visualeditor-inspector-formula-label",
				"simplemathJax-visualeditor-inspector-display-label",
				"simplemathJax-visualeditor-display-default",
				"simplemathJax-visualeditor-display-inline",
				"simplemathJax-visualeditor-display-block",
				"simplemathJax-visualeditor-contextitem-quickedit"
			]
		},
		"ext.SimpleMathJax.visualEditorRaw": {
			"scripts": [
				"resources/ve-smj-raw/ve.smj.Delim.js",
				"resources/ve-smj-raw/ve.smj.RawMathValidator.js",
				"resources/ve-smj-raw/ve.dm.SMJRawMathNode.js",
				"resources/ve-smj-raw/ve.ce.SMJRawMathNode.js",
				"resources/ve-smj-raw/ve.ui.SMJRawMathInspector.js",
				"resources/ve-smj-raw/ve.ui.SMJRawMathTools.js",
				"resources/ve-smj-raw/ve.init.SMJRawMathSetup.js"
			],
			"messages": [
				"smj-ve-rawmath-inspector-title",
				"smj-ve-rawmath-latex-label",
				"smj-ve-rawmath-delim-label",
				"smj-ve-rawmath-context-label",
				"smj-ve-rawmath-tool-title",
				"smj-ve-rawmath-error-braces",
				"smj-ve-rawmath-error-unrecoverable"
			],
			"dependencies": [
				"ext.visualEditor.mwcore",
				"ext.SimpleMathJax"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "SimpleMathJax"
	},
	"MessagesDirs": {
		"SimpleMathJax": ["i18n"]
	},
	"QUnitTestModule": {
		"scripts": [
			"tests/qunit/ve.smj.RawMathValidator.test.js"
		],
		"dependencies": [
			"ext.SimpleMathJax.visualEditorRaw"
		],
		"localBasePath": ".",
		"remoteExtPath": "SimpleMathJax"
	},
	"manifest_version": 2
}
